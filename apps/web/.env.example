# apps/web environment (PUBLIC — anything prefixed VITE_ is embedded in the browser bundle).
# Copy to .env for local use. Placeholders only. NEVER put a secret here.

# Base URL of the BuildTogether API (@buildtogether/api).
VITE_API_BASE_URL="http://localhost:4000"

# Public Nexconn client app id used by the Chat SDK (NOT the App Secret — that stays in the API).
# Confirm the exact variable name against official Nexconn docs during the integration phase.
VITE_NEXCONN_APP_ID="your-public-nexconn-app-id"
