# apps/desktop PRODUCTION environment — copy to .env.production (gitignored), or provide the same
# variables through the build environment (process env wins over this file).
# Loaded by `pnpm build` / `pnpm desktop:build` / `pnpm desktop:package` (Vite mode "production").
# The build FAILS unless every value below is valid; nothing here falls back to localhost.

# Deployed API origin, embedded in Electron MAIN. Required. Must be https:// on a public host,
# with no path, query, credentials or trailing segments (e.g. https://api.<your-domain>).
BT_API_BASE_URL=""

# Clerk PRODUCTION instance (pk_live_...). Public, non-secret value.
VITE_CLERK_PUBLISHABLE_KEY=""

# Clerk Frontend API hostname for the production instance, without scheme. Required in production;
# it is validated and embedded in the Electron Content Security Policy.
VITE_CLERK_FRONTEND_API_HOST=""

# VITE_API_BASE_URL is intentionally absent: the packaged app always uses the main-process URL.
