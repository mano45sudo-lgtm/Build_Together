# apps/desktop environment. Copy to .env for local use. Placeholders only — NEVER commit secrets.
#
# Two distinct variables, on purpose:
#  - BT_API_BASE_URL is read by the Electron MAIN process (trusted) and handed to the renderer
#    over the typed preload bridge. It is environment-aware; leave unset to use the built-in
#    dev/prod defaults. Never point a packaged build at localhost.
#  - VITE_API_BASE_URL is the renderer fallback used ONLY outside Electron (tests / browser dev).

# API base URL resolved by the main process (dev / staging / prod override).
BT_API_BASE_URL="http://localhost:4000"

# Renderer fallback API base URL (public, embedded in the bundle when set).
VITE_API_BASE_URL="http://localhost:4000"

# --- Clerk authentication (ADR-0006) ---
#
# Clerk's PUBLISHABLE key is a public, non-secret value (pk_test_... / pk_live_...) that
# initializes the browser/Electron Frontend API from the renderer. It is safe to expose, but it
# still must come from the environment (never hardcoded) so dev and prod instances stay separate.
# When unset, the desktop shows an explicit "authentication is not configured" screen rather than
# a broken or fake sign-in UI. Use the SAME Clerk instance the API verifies against.
VITE_CLERK_PUBLISHABLE_KEY=""

# Optional explicit Frontend API host from the same Clerk instance. The host may also be derived
# from the publishable key, but keeping it explicit makes CSP behavior clear across environments.
# VITE_CLERK_FRONTEND_API_HOST="example.clerk.accounts.dev"

# Clerk dashboard setup required for the sign-in screen's network requests:
# - Enable Native API under Native applications.
# - Add each renderer origin to the Clerk instance Backend API `allowed_origins`: use the actual
#   Electron Vite origin shown in devtools (usually http://localhost:5173) and app://bundle for the
#   packaged app. Without this the Frontend API rejects requests carrying both Origin and
#   Authorization headers with `origin_authorization_headers_conflict`.
# - Enable email/password or email-code under User & authentication.
# - Enable Google for both sign-up and sign-in under SSO connections. Allowlist app://bundle/ under
#   Native applications > Allowlist for mobile SSO redirect. OAuth deep links need a packaged app on
#   macOS/Linux; Windows dev uses the Electron app-path registration in the main process.

# NOTE: Nexconn App Secrets, DB credentials, session secrets, etc. live ONLY in apps/api/.env.
# They must never appear here or in any renderer-reachable variable.
