# apps/desktop DEVELOPMENT environment — copy to .env.development (gitignored).
# Loaded by `pnpm desktop:dev` / `pnpm dev` and `pnpm desktop:build:dev` (Vite mode "development").
# Development talks to the local API (`pnpm --filter @buildtogether/api dev`, backed by the local
# Docker PostgreSQL), so plain HTTP on localhost is allowed here. Placeholders only — no secrets.

# Electron MAIN embeds this at build time. Any HTTP(S) origin; defaults to http://localhost:4000.
BT_API_BASE_URL="http://localhost:4000"

# Renderer fallback used ONLY outside Electron (browser dev / tests).
VITE_API_BASE_URL="http://localhost:4000"

# Clerk DEVELOPMENT instance (pk_test_...). Public, non-secret value. The Frontend API host is
# derived from this key in development when VITE_CLERK_FRONTEND_API_HOST is omitted.
VITE_CLERK_PUBLISHABLE_KEY=""
# VITE_CLERK_FRONTEND_API_HOST=""
