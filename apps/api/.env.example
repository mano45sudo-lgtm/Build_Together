# apps/api environment (SERVER-SIDE — real secrets live only here; never commit .env).
# Copy to .env for local use. Placeholders only.

NODE_ENV="development"
PORT="4000"

# Allowed web origin(s) for CORS (comma-separated if multiple).
CORS_ORIGIN="http://localhost:5173"

# --- Required in later phases (leave unset in Phase 0) ---

# PostgreSQL connection string for Prisma (database phase).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/buildtogether?schema=public"

# Session signing secret (auth phase). Generate a strong random value; never commit it.
SESSION_SECRET=""

# Nexconn server credentials for identity mapping + token minting (Nexconn phase).
# The App Secret must NEVER reach the frontend. Confirm names in official Nexconn docs.
NEXCONN_APP_ID=""
NEXCONN_APP_SECRET=""

# Provider-independent AI config (AI phase). Server-side only.
AI_PROVIDER=""
AI_API_KEY=""
