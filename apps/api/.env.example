# apps/api environment (SERVER-SIDE — real secrets live only here; never commit .env).
# Copy to .env for local use. Placeholders only.

NODE_ENV="development"
PORT="4000"

# Allowed web origin(s) for CORS (comma-separated if multiple).
CORS_ORIGIN="http://localhost:5173"

# --- Identity & workspaces (Phase 2) ---

# PostgreSQL connection string for Prisma (required from Phase 2 on). Local/dev example below.
DATABASE_URL="postgresql://buildtogether:buildtogether@localhost:5432/buildtogether?schema=public"

# Used only to derive session-related values; opaque random tokens are stored as SHA-256
# hashes. MUST be a strong random value in production (the app fails closed otherwise).
SESSION_SECRET=""

# Token / invitation lifetimes (seconds). Defaults shown; leave unset to use them.
ACCESS_TOKEN_TTL_SECONDS="900"      # ~15 min access token
REFRESH_TOKEN_TTL_SECONDS="2592000" # ~30 day refresh token
INVITATION_TTL_SECONDS="604800"     # ~7 day invitation expiry

# Rate-limit ceilings (requests per window) for the throttled endpoints.
AUTH_RATE_LIMIT="10"   # register/login/refresh
INVITE_RATE_LIMIT="30" # invitation create/accept

# Base URL used to build invitation accept links (dev transport).
PUBLIC_APP_BASE_URL="http://localhost:5173"

# --- Real-time communication / Nexconn (Phase 3) ---

# Nexconn (RongCloud) app credentials. The App KEY is the public client identifier (echoed to the
# desktop so Web IMLib can `init`); the App SECRET is SERVER-ONLY — it mints tokens and verifies
# callbacks and must NEVER reach the renderer or a VITE_ variable. Leave both unset to run the API
# without chat: the chat module then fails closed with 503 CHAT_UNAVAILABLE (never a fake success).
NEXCONN_APP_KEY=""
NEXCONN_APP_SECRET=""

# Optional server-API endpoint overrides (the SDK's defaults are used when unset).
NEXCONN_PRIMARY_API_DOMAIN=""
NEXCONN_SECONDARY_API_DOMAIN=""

# Client token lifetime (seconds) issued to the desktop, and the accepted clock skew for provider
# server callbacks (ms) used in the replay-window check.
NEXCONN_TOKEN_TTL_SECONDS="3600"
NEXCONN_WEBHOOK_MAX_SKEW_MS="300000"

# Rate-limit ceiling for chat management calls (token mint / conversation create / member ops),
# per 5-minute window. Message transport itself is peer↔Nexconn and never traverses the API.
CHAT_RATE_LIMIT="60"

# --- Required in later phases (leave unset for now) ---

# Transactional email provider for real invitation delivery (until configured, invitations use
# a clearly-labelled DEV transport that returns the link to the authorized inviter).
# SMTP_URL=""

# Provider-independent AI config (AI phase). Server-side only.
AI_PROVIDER=""
AI_API_KEY=""
